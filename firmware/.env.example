# ESP-NOW encryption keys.
# MUST be identical (byte-for-byte) across chopper body, chopper head, and
# chopper receiver — they're peers on the same encrypted ESP-NOW mesh.
#
# Copy this file to .env and fill in real values. See README.md
# ("Generating ESP-NOW keys") for how to generate them. .env is gitignored —
# never commit it.

PMK_KEY=00000000000000000000000000000000
LMK_KEY=00000000000000000000000000000000

# The controller's WiFi MAC address (hex, no separators or with colons —
# both work). Must be identical across body, head, and receiver.
CONTROLLER_MAC=000000000000

# WiFi AP password for the local OTA-update access point this board hosts.
# Only needs to be strong enough to keep strangers off your local AP —
# pick your own, at least 8 characters.
WIFI_AP_PASSWORD=changeme123
